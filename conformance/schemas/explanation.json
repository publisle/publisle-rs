          "binding": {
            "type": "string"
          },
          "description": {
            "type": "array",
            "items": {
              "$ref": "urn:publisle:schema:rich-content#/$defs/flow"
            }
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "maxItems": 4096
    }
  },
  "required": [],
  "additionalProperties": false
}
