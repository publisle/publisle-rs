{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:publisle:schema:readable",
  "type": "object",
  "properties": {
    "sourceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "authored"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "generated"
            },
            "generator": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "generator", "version", "source"],
          "additionalProperties": false
        }
      ]
    },
    "binding": {
      "type": "string"
    },
    "content": {
      "$ref": "urn:publisle:schema:explanation"
    }
  },
  "required": ["sourceDigest", "provenance"],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": ["binding"],
      "not": {
        "required": ["content"]
      }
    },
    {
      "required": ["content"],
      "not": {
        "required": ["binding"]
      }
    }
  ]
}
