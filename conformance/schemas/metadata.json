{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:publisle:schema:metadata",
  "title": "Publisle beta metadata",
  "type": "object",
  "properties": {
    "documentType": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "direction": {
      "enum": ["ltr", "rtl", "auto"]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "affiliation": {
            "type": "string"
          },
          "identifiers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
    },
    "modifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])"
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": ["src"],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "urn:publisle:schema:json-value"
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
