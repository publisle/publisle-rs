    "semantics": {
      "entities": [
        {
          "id": "wave",
          "kind": "concept",
          "name": "Wave",
          "origin": "authored",
          "description": "A periodic signal; no particular rendering engine is required to read this declaration."
        },
        {
          "id": "frequency",
          "kind": "input",
          "name": "Frequency",
          "origin": "declared-rule",
          "binding": "/payload/frequency",
          "valueType": "number",
          "unit": "Hz",
          "dimension": "time^-1",
          "domain": {
            "minimum": 0,
            "maximum": 20
          },
          "default": 2,
          "effects": ["spectrum", "plot"]
        },
        {
          "id": "amplitude",
          "kind": "input",
          "name": "Amplitude",
          "origin": "declared-rule",
          "binding": "/payload/amplitude",
          "valueType": "number",
          "domain": {
            "minimum": 0
          },
          "default": 1,
          "effects": ["spectrum"]
        },
        {
          "id": "spectrum",
          "kind": "output",
          "name": "Spectrum",
          "origin": "calculated-result",
          "binding": "/payload/spectrum",
          "valueType": "array",
          "references": ["frequency", "amplitude", "evidence"],
          "interpretation": "Supplied spectral samples; scientific correctness is not inferred.",
          "implementation": {
            "status": "implementation-bound",
            "identity": "host:wave-engine",
            "limitation": "Computing these samples requires the host's implementation."
          }
        },
        {
          "id": "reset",
          "kind": "action",
          "name": "Reset",
          "origin": "authored",
          "inputs": ["frequency", "amplitude"],
          "results": ["state"],
          "implementation": {
            "status": "implementation-bound",
            "identity": "host:reset",
            "limitation": "The host executes reset; this declaration describes its effect only."
          }
        },
        {
          "id": "state",
          "kind": "state",
          "name": "Initial parameters",
          "origin": "authored",
          "binding": "/payload/reset",
          "initial": {
            "frequency": 2,
            "amplitude": 1
          },
          "reset": "reset",
          "transient": false
        },
        {
          "id": "plot",
          "kind": "view",
          "name": "Spectrum plot",
          "origin": "authored",
          "binding": "/payload/plot",
          "role": "plot",
          "references": ["spectrum"]
        },
        {
          "id": "assumption",
          "kind": "assumption",
          "name": "Periodic signal",
          "origin": "authored",
          "description": "The illustrative signal is assumed periodic."
        },
        {
          "id": "evidence",
          "kind": "evidence",
          "name": "Host-generated sample",
          "origin": "authored",
          "source": "host:wave-engine",
          "description": "No verified computation certificate accompanies these values."
        }
      ]
    }
  },
